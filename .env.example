# Environment Variables - Copy ke .env atau .env.local untuk setup lokal

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================

# Format: mysql://username:password@host:port/database
# Contoh dengan password: mysql://root:mypassword@localhost:3306/lunara
# Contoh tanpa password (default XAMPP/WAMP): mysql://root:@localhost:3306/lunara
DATABASE_URL=mysql://root:@localhost:3306/lunara

# ============================================
# 🔐 AUTHENTICATION
# ============================================

# App ID untuk OAuth (isi dengan nilai dari OAuth provider Anda)
VITE_APP_ID=your-app-id

# Secret key untuk JWT signing (ubah di production!)
JWT_SECRET=your-secret-key-change-in-production

# OAuth Server URL
OAUTH_SERVER_URL=http://localhost:3000

# Owner OpenID (untuk memberi role admin ke user tertentu)
OWNER_OPEN_ID=your-owner-open-id

# ============================================
# 🤖 API INTEGRATIONS (Optional)
# ============================================

# Forge API (Built-in)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# OpenAI API (untuk AI Chat features)
# OPENAI_API_KEY=sk-...

# ============================================
# 🌍 ENVIRONMENT
# ============================================

# development, staging, production
NODE_ENV=development

# Port untuk server (optional, default 3000)
# PORT=3000

# ============================================
# 📝 NOTES
# ============================================
# 
# 1. Jangan commit .env.local ke git (sudah di .gitignore)
# 2. Gunakan .env.local untuk kredensial lokal Anda
# 3. Gunakan .env untuk konfigurasi yang shared
# 4. Selalu ubah JWT_SECRET di production!
# 5. Pastikan MySQL server berjalan sebelum pnpm dev
#
